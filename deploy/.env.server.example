# Template of the stand's server .env (runbook: deploy/README.md).
# Copy to <DEPLOY_PATH>/shared/.env ON THE SERVER, `chmod 600`, and replace every
# __SET_ON_SERVER__ value. Never commit the filled file and never put it into
# the code checkout: deploy/remote-deploy.sh refuses to start while a placeholder
# is present or while the file is readable by group/others.
# This template is also what CI uses to validate `docker compose config`.

# fixture  - synthetic records only (stage 1 default);
# replay   - bounded historical window loaded by the replay-loader from an
#            accepted curated snapshot (INFRA_REPLAY_SNAPSHOT_ID required);
# received - local JSON inbox (candidate format) polled by received-watcher.
# The SPA is rebuilt with the same mode on the next deploy.
INFRA_MODE=fixture

# Host ports, bound to 127.0.0.1 only. Reach them through an SSH tunnel.
WEB_PORT=8080
API_PORT=8000

# PostgreSQL stays on the Compose network (not published). Use a URL-safe value,
# for example the output of `openssl rand -hex 32`. POSTGRES_USER owns the schema: it
# runs migrations, backups and one-off loads, never the API or the worker.
POSTGRES_DB=infra_pulse
POSTGRES_USER=infra_pulse
POSTGRES_PASSWORD=__SET_ON_SERVER__

# Runtime role infra_pulse_app of api and worker: DML only, no DDL (deploy/README.md
# «Роли PostgreSQL»). deploy/remote-deploy.sh replaces this placeholder, or adds the line
# when it is missing, with `openssl rand -hex 32` and never prints it; the migrate
# service makes it the role's password. 24-128 URL-safe characters if set by hand.
INFRA_DB_APP_PASSWORD=__SET_ON_SERVER__
# Rollback to the owner (api and worker as POSTGRES_USER, as before 29.09.2026):
# uncomment this one line and redeploy; comment it out again to return to the role.
# INFRA_DB_APP_DSN=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Server directories outside the code checkout, mounted read-only into the
# one-shot replay-loader (/data) and the received-watcher (/inbox).
INFRA_SERVER_DATA_DIR=/srv/infra-pulse/data
INFRA_SERVER_INBOX_DIR=/srv/infra-pulse/inbox

# replay: namespace used by both the loader and the API; snapshot_id is printed
# in the loader's JSON report. Uncomment after loading a window.
INFRA_REPLAY_NAMESPACE=stand-replay
# INFRA_REPLAY_SNAPSHOT_ID=

# received: the watcher and the API must use the same namespace and stream.
INFRA_RECEIVED_NAMESPACE=stand-received
INFRA_RECEIVED_STREAM_ID=stand-received-1
# Uncomment to start the long-running inbox watcher together with the stack.
# COMPOSE_PROFILES=received

# Local review notes: on a tunnel-only stand they are unauthenticated (actor is the
# fixed local operator, D02/D03 open); with public access (directory login) the author
# comes from the session. Keep false unless the team agreed to test notes.
INFRA_ENABLE_LOCAL_REVIEWS=false

# ---- Public access (deploy/README.md «Публичный доступ»). A tunnel-only stand keeps
# ---- this block commented out. Fill values only in the server .env, never here.
# true: every deploy adds deploy/compose.public.yaml (same as remote-deploy.sh --public).
# STAND_PUBLIC=
# DNS name whose A/AAAA record points to the server; contact for Let's Encrypt.
# PUBLIC_HOST=
# ACME_EMAIL=
# Empty = Let's Encrypt staging. Production directory only after the staging smoke.
# ACME_CA=
# HSTS max-age in seconds: empty = 300 while on staging; 31536000 after the real cert.
# HSTS_MAX_AGE=
# Test directory (lldap). Base DN is not secret; the rest: `openssl rand -hex 32`.
# LLDAP_BASE_DN=
# LLDAP_JWT_SECRET=
# LLDAP_KEY_SEED=
# LLDAP_ADMIN_PASSWORD=
# true: public read-only API docs at https://<PUBLIC_HOST>/api/docs and /api/openapi.json (every route still needs a session or token); Caddy keeps /docs, /redoc and /openapi.json closed. Empty = false.
# INFRA_PUBLIC_DOCS=
# Absolute session lifetime of the web login, minutes (empty = 480).
# INFRA_SESSION_TTL_MINUTES=

# B1x: observation API batches per integration token per minute (empty = 60).
# Tokens are issued with `python -m infra_pulse_backend.admin token create`, never kept here.
# INFRA_INTEGRATION_REQUESTS_PER_MINUTE=

# ---- Backups (OPS-02; deploy/README.md «Резервные копии и восстановление»).
# Enable the daily backup service by adding the profile (with received:
# COMPOSE_PROFILES=backup,received). The directory must exist before the deploy.
# COMPOSE_PROFILES=backup
# Host directory outside the checkout, owned by the deploy user, chmod 700.
BACKUP_DIR=/srv/infra-pulse/backups
# `id -u deploy` / `id -g deploy`: the backup container writes as this user.
BACKUP_UID=1000
BACKUP_GID=1000
# Daily start, HH:MM UTC (00:30 UTC = 03:30 MSK). Backups older than KEEP_DAYS are
# removed, but the newest KEEP_MIN complete ones are always kept.
BACKUP_AT=00:30
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MIN=3

# ---- OPS-G: Grafana, profile `analytics` (deploy/README.md «Grafana»). Needs the
# ---- «Public access» block (Grafana is served only behind Caddy). Keep commented out on a stand without Grafana.
# Starts grafana with the stack (combine profiles with commas, e.g. backup,analytics).
# COMPOSE_PROFILES=analytics
# PostgreSQL login of Grafana, member of analytics_read (migration 0016); created by
# deploy/grafana/create-reader.sh. Password: `openssl rand -hex 32`.
# GRAFANA_DB_USER=grafana_reader
# 1: the SPA shows the «Графики сигналов» menu link to analysts and admins (rebuilt on deploy).
# INFRA_GRAFANA_LINK=1
# GRAFANA_DB_PASSWORD=
