{
  "name": "infra-pulse-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:words": "node scripts/check-dispatcher-words.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tabler/icons-react": "3.46.0",
    "antd": "^6.6.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
