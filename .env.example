# Copy locally to .env; do not commit secrets. URLs below are local development only.
INFRA_MODE=scaffold
# Reserved runtime paths, unused by scaffold/fixture; research stays in data-science/.
INFRA_DATA_ROOT=./var/data
INFRA_ARTIFACT_ROOT=./var/models
# Future inference release: set INFRA_ARTIFACT_ROOT=/models and mount the approved
# exported bundle read-only. Current Compose does not mount or load models yet.
API_PORT=8000
WEB_PORT=8080
DB_PORT=5432
POSTGRES_DB=infra_pulse
POSTGRES_USER=infra_pulse
POSTGRES_PASSWORD=local-dev-only
# `make compose`: api and worker connect as the runtime role infra_pulse_app (DML only);
# the migrate service sets this password (24-128 URL-safe characters). Local value only.
INFRA_DB_APP_PASSWORD=local-dev-only-app-password
DATABASE_URL=postgresql+psycopg://infra_pulse:local-dev-only@localhost:5432/infra_pulse
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
